generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String    // HTML from TipTap editor
  excerpt       String?   // Auto-generated or manual
  coverImage    String?   // URL to stored image
  coverImageAlt String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // SEO fields
  metaTitle       String?  // Falls back to title if empty
  metaDescription String?  // 150–160 chars, AI-generated or manual
  ogImage         String?  // Falls back to coverImage

  // Relations
  authorId   String
  author     Author    @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  tags       Tag[]

  // Computed / cached
  readingTimeMinutes Int?

  @@index([slug])
  @@index([published, publishedAt])
}

model Author {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  bio      String?
  avatar   String?
  articles Article[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  EDITOR
}
